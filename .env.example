# ────────────────────────────────────────────────────────────────
# ✅ FILE STORE BOT — by @trinityXmods · https://github.com/Trinity-Mods
# 📩 Need help? Telegram: @the_universal_being
# ────────────────────────────────────────────────────────────────
#
# 🔑 Sample settings for running the bot on a VPS / PC.
#    1. Copy this file and name the copy ".env"   →   cp .env.example .env
#    2. Fill in your values (keep the .env file private — it contains your bot token!)
#    3. Start the bot                             →   python3 main.py
#
# Every option is explained in config.py. Lines starting with # are ignored.

# ━━━━━━━━━━ 🔴 REQUIRED ━━━━━━━━━━
TG_BOT_TOKEN=
APP_ID=
API_HASH=
# the database channel ID starts with -100
CHANNEL_ID=
OWNER_ID=
# looks like: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_URL=
DB_NAME=FileStoreBot

# ━━━━━━━━━━ 👑 OWNER & ADMINS ━━━━━━━━━━
# your public username without @
OWNER_TAG=
# extra admin IDs separated by spaces
ADMINS=

# ━━━━━━━━━━ 🔐 ACCESS MODE: fsub | referral | dual | off ━━━━━━━━━━
ACCESS_MODE=fsub

# ━━━━━━━━━━ 📢 FORCE-SUB (0 – 4 chats, leave unused ones empty) ━━━━━━━━━━
FORCE_SUB_CHANNEL=
FORCE_SUB_CHANNEL2=
FORCE_SUB_CHANNEL3=
FORCE_SUB_CHANNEL4=

# ━━━━━━━━━━ 👥 REFERRALS ━━━━━━━━━━
REFERRAL_COUNT=3
# seconds files stay unlocked after reaching the goal — 0 = forever
REFERRAL_EXPIRE=0

# ━━━━━━━━━━ 🖼️ PICTURES (link, file_id or repo path — leave empty for none) ━━━━━━━━━━
START_PIC=
FORCE_PIC=
REFERRAL_PIC=

# ━━━━━━━━━━ 📁 FILE DELIVERY ━━━━━━━━━━
TIME=600
PROTECT_CONTENT=FALSE
DISABLE_CHANNEL_BUTTON=TRUE

# ━━━━━━━━━━ 🔗 SHORTENER & 💎 PREMIUM ━━━━━━━━━━
USE_SHORTLINK=FALSE
SHORTLINK_API_URL=gplinks.com
SHORTLINK_API_KEY=
U_S_E_P=TRUE
VERIFY_EXPIRE=43200
USE_PAYMENT=TRUE
UPI_ID=
UPI_IMAGE_URL=
